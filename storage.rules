rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function validImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function validBusinessMediaInput() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /tracking_checkpoints/{uid}/{sessionId}/{objectId} {
      allow create: if resource == null
        && signedIn()
        && request.auth.uid == uid
        && validImage()
        && firestore.exists(
          /databases/(default)/documents/trackingSessions/$(sessionId)
        )
        && firestore.get(
          /databases/(default)/documents/trackingSessions/$(sessionId)
        ).data.scalerId == uid
        && firestore.get(
          /databases/(default)/documents/trackingSessions/$(sessionId)
        ).data.status == 'active';
      allow read: if signedIn() && (
        request.auth.uid == uid
        || firestore.get(
          /databases/(default)/documents/trackingSessions/$(sessionId)
        ).data.businessId == request.auth.uid
        || isAdmin()
      );
      allow update, delete: if false;
    }

    // Material handoff evidence is uploaded by an assigned participant and
    // promoted into authoritative state only after trusted Function checks.
    match /material_handoffs/{uid}/{handoffId}/{objectId} {
      allow create: if resource == null
        && signedIn()
        && request.auth.uid == uid
        && validImage()
        && firestore.exists(/databases/(default)/documents/materialHandoffs/$(handoffId))
        && firestore.exists(/databases/(default)/documents/jobRooms/$(
          firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
        ))
        && firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.scalerId == uid
        && firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.businessId ==
          firestore.get(/databases/(default)/documents/jobRooms/$(
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
          )).data.businessId
        && (
          firestore.get(/databases/(default)/documents/jobRooms/$(
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
          )).data.get('scalerId', '') == uid
          || firestore.get(/databases/(default)/documents/jobRooms/$(
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
          )).data.get('scalerIds', []).hasAny([uid])
        )
        && (
          (
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.fulfillmentType ==
              'third_party_pickup'
            && firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.scalerId == uid
          )
          || (
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.fulfillmentType !=
              'third_party_pickup'
            && (
              firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.scalerId == uid
              || firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.businessId == uid
            )
          )
        );
      allow read: if signedIn()
        && firestore.exists(/databases/(default)/documents/materialHandoffs/$(handoffId))
        && firestore.exists(/databases/(default)/documents/jobRooms/$(
          firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
        ))
        && (
          firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.scalerId == request.auth.uid
          || firestore.get(/databases/(default)/documents/jobRooms/$(
            firestore.get(/databases/(default)/documents/materialHandoffs/$(handoffId)).data.zoneId
          )).data.businessId == request.auth.uid
          || isAdmin()
        );
      allow update, delete: if false;
    }

    // Existing field-service photo workflows remain private to their uploader.
    match /completionProofs/{campaignId}/{uid}/{completionId}/{proofType}/{fileName} {
      allow create: if signedIn() && request.auth.uid == uid && validImage();
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    match /installation_proofs/{campaignId}/{uid}/{fileName} {
      allow create: if signedIn() && request.auth.uid == uid && validImage();
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // Business-owned reusable social images. Provider credentials and publishing
    // authority never live in Storage or client-readable metadata.
    match /social_media/{uid}/{mediaId}/{fileName} {
      allow create: if signedIn() && request.auth.uid == uid && validImage();
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // Server-issued, create-once Business media originals. Canonical processing,
    // approval, and normalized rendition writes use creative-media-core only.
    match /business_media_private/{uid}/{assetId}/{revisionId}/original {
      allow create: if resource == null
        && signedIn()
        && request.auth.uid == uid
        && validBusinessMediaInput()
        && firestore.exists(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId))
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.businessUid == uid
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.assetId == assetId
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.revisionId == revisionId
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.storagePath ==
          'business_media_private/' + uid + '/' + assetId + '/' + revisionId + '/original'
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.status == 'open'
        && firestore.get(/databases/(default)/documents/businessMediaUploadIntents/$(revisionId)).data.expiresAt > request.time;
      allow read: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    match /business_media_private/{uid}/{assetId}/{revisionId}/renditions/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Provider-free physical-marketing masters and proofs are normalized and
    // written only by physical-marketing-core. The owning Business may fetch an
    // exact known artifact, but cannot list, replace, publish, or share it.
    match /physical_marketing_private/{uid}/{materialId}/{versionId}/{fileName} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Immutable publication derivatives created only by the Landing Page
    // backend. Public pages may read exact objects; clients cannot create,
    // replace, delete, or list through a broader rule.
    match /landing_page_public/{uid}/{pageId}/{versionId}/{slotId}/{fileName} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
