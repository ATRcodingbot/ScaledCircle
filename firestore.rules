rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      allow read:
        if isSignedIn()
        && request.auth.uid == userId;


      allow create:
        if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'companyName',
          'postalCode',
          'contactNumber',
          'role',
          'accountType',
          'activeView',
          'active',
          'betaAccess',
          'earlyAccessSource',
          'discoverySource',
          'referrerName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'postalCode',
          'role',
          'accountType',
          'activeView',
          'active',
          'betaAccess',
          'discoverySource',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.role in ['business', 'scaler']
        && request.resource.data.accountType == request.resource.data.role
        && request.resource.data.activeView == request.resource.data.role
        && request.resource.data.active == false
        && request.resource.data.betaAccess == 'pending'
        && (
          !request.resource.data.keys().hasAll(['contactNumber'])
          || request.resource.data.contactNumber is string
        )
        && request.resource.data.discoverySource in [
          'personal_referral',
          'search_engine',
          'social_media',
          'online_ad',
          'event_or_group',
          'other'
        ]
        && (
          request.resource.data.discoverySource != 'personal_referral'
          || (
            request.resource.data.keys().hasAll(['referrerName'])
            && request.resource.data.referrerName is string
            && request.resource.data.referrerName.size() > 0
          )
        );


      allow update:
        if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'companyName',
          'postalCode',
          'contactNumber',
          'accountType',
          'activeView',
          'weatherCoverageCountyIds',
          'weatherCoverageEnabled',
          'weatherEmailAlertsEnabled',
          'updatedAt'
        ])
        && request.resource.data.accountType in ['business', 'scaler']
        && request.resource.data.activeView in ['business', 'scaler']
        && (
          !request.resource.data.keys().hasAll(['weatherCoverageCountyIds'])
          || (
            request.resource.data.weatherCoverageCountyIds is list
            && request.resource.data.weatherCoverageCountyIds.size() <= 24
            && request.resource.data.weatherCoverageCountyIds.hasOnly([
              'allegany',
              'anne_arundel',
              'baltimore',
              'baltimore_city',
              'calvert',
              'caroline',
              'carroll',
              'cecil',
              'charles',
              'dorchester',
              'frederick',
              'garrett',
              'harford',
              'howard',
              'kent',
              'montgomery',
              'prince_georges',
              'queen_annes',
              'saint_marys',
              'somerset',
              'talbot',
              'washington',
              'wicomico',
              'worcester'
            ])
          )
        )
        && (
          !request.resource.data.keys().hasAll(['weatherCoverageEnabled'])
          || request.resource.data.weatherCoverageEnabled is bool
        )
        && (
          !request.resource.data.keys().hasAll(['weatherEmailAlertsEnabled'])
          || request.resource.data.weatherEmailAlertsEnabled is bool
        );

    }



    // ============================================================
    // CAMPAIGNS
    // ============================================================

    match /campaigns/{campaignId} {

      allow read:
        if isApprovedAccount();


      allow create:
        if isApprovedAccount()
        && request.resource.data.businessId == request.auth.uid
        && !request.resource.data.keys().hasAny(financialCampaignFields());


      allow update:
        if isApprovedAccount()
        && resource.data.businessId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(financialCampaignFields());


      allow delete:
        if false;



      // ----------------------------------------------------------
      // APPLICATIONS
      // ----------------------------------------------------------

      match /applications/{scalerId} {


        allow create:
          if isApprovedAccount()
          && request.auth.uid == scalerId;


        allow read:
          if isApprovedAccount()
          &&
          (
            request.auth.uid == scalerId
            ||
            get(
              /databases/$(database)/documents/campaigns/$(campaignId)
            ).data.businessId == request.auth.uid
          );


        allow update:
          if isApprovedAccount()
          &&
          get(
            /databases/$(database)/documents/campaigns/$(campaignId)
          ).data.businessId == request.auth.uid;

      }



      // ----------------------------------------------------------
      // ASSIGNED SCALERS
      // ----------------------------------------------------------

      match /assignedScalers/{scalerId} {


        allow read:
          if isApprovedAccount()
          &&
          (
            request.auth.uid == scalerId
            ||
            get(
              /databases/$(database)/documents/campaigns/$(campaignId)
            ).data.businessId == request.auth.uid
          );


        allow create, update:
          if isApprovedAccount()
          && get(
            /databases/$(database)/documents/campaigns/$(campaignId)
          ).data.businessId == request.auth.uid;


        allow delete:
          if isAdmin();

      }

    }



    // ============================================================
    // SERVER-MANAGED PUBLIC SITE DATA
    // ============================================================

    match /campaignTrackingCodes/{trackingCode} {

      // Public redirects and metrics are handled by Cloud Functions. Keeping
      // codes off the client prevents destination tampering and raw event
      // enumeration.
      allow read, write:
        if false;

      match /events/{eventId} {
        allow read, write:
          if false;
      }

    }


    match /waitlist/{entryId} {

      // The public form writes through joinWaitlist, which validates and
      // rate-limits the shape. Administrators may inspect launch entries.
      allow read:
        if isAdmin();

      allow create, update, delete:
        if false;

    }

    match /outboundEmailJobs/{jobId} {

      // Only trusted backend code may author or inspect outbound messages.
      // This prevents clients from choosing recipients, sender identities, or
      // arbitrary message content.
      allow read, create, update, delete:
        if false;

    }

    match /adminIssues/{issueId} {
      // Actionable issue details are visible only inside the authoritative
      // Admin experience. Creation and resolution remain server-only.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /adminAuditEvents/{eventId} {
      // Role-transfer and login-readiness evidence is immutable and authored
      // only by trusted backend/operator code.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }


    match /weatherOpportunityCache/{cacheId} {

      allow read, write:
        if false;

    }



    // ============================================================
    // APPLICATION COLLECTION-GROUP QUERIES
    // ============================================================

    match /{path=**}/applications/{applicationId} {

      allow read:
        if isApprovedAccount()
        && resource.data.scalerId == request.auth.uid;

    }



    // ============================================================
    // CAMPAIGN ZONES
    // ============================================================

    match /campaignZones/{zoneId} {

      allow read:
        if isApprovedAccount();


      allow create:
        if isApprovedAccount()
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.assignedScalerId == null
        && request.resource.data.status == 'unassigned'
        && request.resource.data.keys().hasOnly([
          'campaignId', 'businessId', 'zoneName', 'shapeType',
          'serviceAreaType', 'serviceArea', 'serviceAreaPointCount',
          'serviceAreaCenter', 'serviceAreaRadiusMeters', 'estimatedHomes',
          'homeCountStatus', 'homeCountMethod', 'homeCountConfidence',
          'homeCountConfidenceScore', 'assignedScalerId',
          'assignedScalerEmail', 'status', 'createdAt', 'updatedAt'
        ]);


      allow update:
        if isApprovedAccount()
        && resource.data.businessId == request.auth.uid
        && resource.data.assignedScalerId == null
        && (!('mapLocked' in resource.data) || resource.data.mapLocked != true)
        && get(
          /databases/$(database)/documents/campaigns/$(resource.data.campaignId)
        ).data.status == 'draft'
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.campaignId == resource.data.campaignId
        && request.resource.data.assignedScalerId == resource.data.assignedScalerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'zoneName', 'shapeType', 'serviceAreaType', 'serviceArea',
          'serviceAreaPointCount', 'serviceAreaCenter',
          'serviceAreaRadiusMeters', 'zoneAreaSquareMeters', 'zoneAreaAcres',
          'zoneAreaSquareMiles', 'zonePerimeterMeters',
          'estimatedWalkingMeters', 'estimatedWalkingMiles',
          'estimatedMinutes', 'suggestedBasePay', 'recommendedScalerCount',
          'estimatedHomes', 'homeCountStatus', 'homeCountMethod',
          'homeCountConfidence', 'homeCountConfidenceScore',
          'analysisStatus', 'analysisUpdatedAt', 'updatedAt'
        ]);


      allow delete:
        if isAdmin();

    }



    // Shared Property Intelligence cache is written and served only by the
    // trusted backend. Clients receive sanitized results through the callable.
    match /propertyIntelligenceCache/{analysisId} {
      allow read, create, update, delete: if false;
    }

    // AI interpretations, provider usage metadata, and rate-limit counters are
    // backend-only. Entitled clients receive a sanitized response via the
    // analyzeScaleIntelligence callable and cannot forge or enumerate results.
    match /intelligenceAnalysisCache/{analysisId} {
      allow read, create, update, delete: if false;
    }

    match /intelligenceRateLimits/{windowId} {
      allow read, create, update, delete: if false;
    }

    // Business-supplied grounding profiles are owner-readable. Validation,
    // versioning, and every write flow through saveBusinessGrowthProfile.
    match /businessGrowthProfiles/{businessId} {
      allow read: if isApprovedAccount() && request.auth.uid == businessId;
      allow create, update, delete: if false;
    }

    // Generated drafts are owner-readable; model, prompt, usage, and source
    // metadata are backend-authored and cannot be forged by a client.
    match /managedGrowthArtifacts/{artifactId} {
      allow read: if isApprovedAccount() && resource.data.businessUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /managedGrowthRateLimits/{windowId} {
      allow read, create, update, delete: if false;
    }

    // The generated-file recipient is distinct from Auth, billing, and support
    // email. Owners may read it; validated writes use platform-core only.
    match /artifactDeliveryPreferences/{businessId} {
      allow read: if isApprovedAccount() && request.auth.uid == businessId;
      allow create, update, delete: if false;
    }

    match /artifactDeliveryEmailJobs/{jobId} {
      allow read, create, update, delete: if false;
    }

    // Social account projections contain display/capability state only. Tokens,
    // provider credentials, approval authority, and publishing results are backend-only.
    match /socialConnections/{businessId}/providers/{providerId} {
      allow read: if isApprovedAccount() && request.auth.uid == businessId;
      allow create, update, delete: if false;
    }

    match /socialPostDrafts/{draftId} {
      allow read: if isApprovedAccount() && resource.data.businessUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /socialPublishingJobs/{jobId} {
      allow read: if isApprovedAccount() && resource.data.businessUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /socialMediaLibraries/{businessId}/items/{mediaId} {
      allow read: if isApprovedAccount() && request.auth.uid == businessId;
      allow create, update, delete: if false;
    }

    match /socialConnectionCredentials/{document=**} {
      allow read, write: if false;
    }

    // Areas and discovery preferences are separate from identity and billing.
    // Owners can read their sanitized projection; versioned writes and matching
    // flow through platform-core so clients cannot spoof role or match reasons.
      match /discoveryPreferences/{userId} {
      allow read: if isApprovedAccount() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }



    // ============================================================
    // CAMPAIGN GPS ROUTES
    // ============================================================

    match /campaignRoutes/{routeId} {
      allow read:
        if isApprovedAccount()
        &&
        (
          resource.data.scalerId == request.auth.uid
          || get(
            /databases/$(database)/documents/campaigns/$(resource.data.campaignId)
          ).data.businessId == request.auth.uid
          || isAdmin()
        );

      // Native and legacy/simulation routes are both stamped and written by
      // trusted backend code. A client cannot self-declare a legacy source.
      allow create, update, delete: if false;

    }

    // Native tracking evidence is written only by trusted Cloud Functions.
    // Scalers can read their own session; the campaign owner can review it.
    // Neither party can alter uploaded evidence from a client.
    match /trackingSessions/{sessionId} {
      allow read:
        if isApprovedAccount()
        && (
          resource.data.scalerId == request.auth.uid
          || resource.data.businessId == request.auth.uid
          || isAdmin()
        );

      allow create, update, delete: if false;

      match /chunks/{chunkId} {
        allow read:
          if isApprovedAccount()
          && (
            get(
              /databases/$(database)/documents/trackingSessions/$(sessionId)
            ).data.scalerId == request.auth.uid
            || get(
              /databases/$(database)/documents/trackingSessions/$(sessionId)
            ).data.businessId == request.auth.uid
            || isAdmin()
          );

        allow create, update, delete: if false;
      }

      // Matching-job email jobs are created and processed only by trusted backend code.
      match /scalerJobAlertEmailJobs/{jobId} {
        allow read, create, update, delete: if false;
      }

      match /checkpoints/{checkpointId} {
        allow read:
          if isApprovedAccount()
          && (
            get(
              /databases/$(database)/documents/trackingSessions/$(sessionId)
            ).data.scalerId == request.auth.uid
            || get(
              /databases/$(database)/documents/trackingSessions/$(sessionId)
            ).data.businessId == request.auth.uid
            || isAdmin()
          );

        allow create, update, delete: if false;
      }
    }

    match /activeTrackingSessions/{scalerId} {
      allow read, create, update, delete: if false;
    }




    // ============================================================
    // CAMPAIGN LOCATIONS
    // ============================================================

    match /campaignLocations/{locationId} {


      allow read:
        if isApprovedAccount();


      allow create:
        if isApprovedAccount();


      allow update:
        if isApprovedAccount();


      allow delete:
        if isAdmin();

    }




    // ============================================================
    // COMPLETIONS
    // ============================================================

    match /campaignCompletions/{completionId} {


      allow create:
        if isApprovedAccount()
        &&
        request.resource.data.scalerId == request.auth.uid
        && !request.resource.data.keys().hasAny(financialCompletionFields());


      allow read:
        if isApprovedAccount()
        &&
        (
          resource.data.scalerId == request.auth.uid
          ||
          resource.data.businessId == request.auth.uid
        );


      allow update:
        if isApprovedAccount()
        &&
        (
          resource.data.scalerId == request.auth.uid
          ||
          resource.data.businessId == request.auth.uid
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(financialCompletionFields());


      allow delete:
        if isAdmin();

    }




    // ============================================================
    // WALLETS
    // ============================================================

    match /wallets/{walletId} {


      allow read:
        if isApprovedAccount()
        &&
        request.auth.uid == walletId;


      // Wallets are legacy/sanitized projections only. They are never an
      // authoritative cash ledger and all writes are trusted-backend only.
      allow create, update, delete: if false;



      // ----------------------------------------------------------
      // WALLET TRANSACTIONS
      // ----------------------------------------------------------

      match /transactions/{transactionId} {


        allow read:
          if isApprovedAccount()
          &&
          request.auth.uid == walletId;


        allow create, update, delete: if false;

      }



      // ----------------------------------------------------------
      // PROMOTIONAL CREDITS
      // ----------------------------------------------------------

      match /promoRedemptions/{promoId} {


        allow read:
          if isApprovedAccount()
          &&
          request.auth.uid == walletId;


        allow create:
          if isAdmin();


        allow update, delete:
          if false;

      }

    }




    // ============================================================
    // GLOBAL WALLET TRANSACTIONS
    // ============================================================

    match /walletTransactions/{transactionId} {


      allow read:
        if isApprovedAccount()
        &&
        (
          resource.data.businessId == request.auth.uid
          ||
          resource.data.scalerId == request.auth.uid
        );


      allow create, update, delete: if false;

    }

    // ============================================================
    // SERVER-AUTHORITATIVE FINANCIAL RECORDS
    // ============================================================

    match /stripeCustomers/{businessId} {
      allow read: if isAdmin() || (isApprovedAccount() && request.auth.uid == businessId);
      allow create, update, delete: if false;
    }

    match /stripeConnectedAccounts/{scalerId} {
      allow read: if isAdmin() || (isApprovedAccount() && request.auth.uid == scalerId);
      allow create, update, delete: if false;
    }

    match /campaignPayments/{paymentId} {
      allow read: if isAdmin() || (
        isApprovedAccount() && resource.data.businessId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /scalerTransfers/{transferId} {
      allow read: if isAdmin() || (
        isApprovedAccount() && (
          resource.data.scalerId == request.auth.uid ||
          resource.data.businessId == request.auth.uid
        )
      );
      allow create, update, delete: if false;
    }

    match /assignmentCompensations/{zoneId} {
      allow read: if isAdmin() || (
        isApprovedAccount() && (
          resource.data.scalerId == request.auth.uid ||
          resource.data.businessId == request.auth.uid
        )
      );
      allow create, update, delete: if false;
    }

    match /zoneGroupAssignments/{zoneId} {
      allow read: if isAdmin() || (isApprovedAccount() && (
        resource.data.businessId == request.auth.uid ||
        (resource.data.acceptedScalerIds is list && request.auth.uid in resource.data.acceptedScalerIds)
      ));
      allow create, update, delete: if false;
    }

    match /zoneScalerParticipations/{participantId} {
      allow read: if isAdmin() || (isApprovedAccount() && (
        resource.data.businessId == request.auth.uid ||
        resource.data.scalerUid == request.auth.uid
      ));
      allow create, update, delete: if false;
    }

    match /financialOperations/{operationId} {
      allow read: if isAdmin() || (
        isApprovedAccount() && resource.data.ownerId == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, create, update, delete: if false;
    }




    // ============================================================
    // MARKETING ASSETS
    // ============================================================

    match /marketingAssets/{assetId} {


      allow read:
        if isApprovedAccount();


      allow create, update:
        if isApprovedAccount();


      allow delete:
        if isAdmin();

    }




    // ============================================================
    // VERIFIED CAMPAIGN REVIEWS
    // ============================================================

    match /reviews/{reviewId} {

      allow read:
        if isApprovedAccount();


      // Reviews are written only by submitCampaignReview after the server
      // verifies campaign ownership and completed participation.
      allow create, update, delete:
        if false;

    }



    // ============================================================
    // REVIEW FRAUD / SCAM REPORTS
    // ============================================================

    match /reviewReports/{reportId} {

      allow read:
        if isApprovedAccount()
        &&
        (
          resource.data.reporterId == request.auth.uid
          ||
          isAdmin()
        );


      // Reports are created only by reportCampaignReview, which enforces
      // the 72-hour window and preserves the original locked review.
      allow create, update, delete:
        if false;

    }



    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      // A missing deterministic id contains no private data; existing
      // notifications remain readable only by their recipient.
      allow get:
        if isApprovedAccount()
        && (
          resource == null
          || resource.data.userId == request.auth.uid
        );


      allow list:
        if isApprovedAccount()
        && resource.data.userId == request.auth.uid;


      // Authoritative event notifications are written only by Admin SDK
      // callables/triggers. Clients cannot impersonate a system event.
      allow create:
        if false;


      allow update:
        if isApprovedAccount()
        &&
        resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'readAt'])
        && request.resource.data.read == true;


      allow delete:
        if false;

    }




    // ============================================================
    // AUDIT LOGS
    // ============================================================

    match /auditLogs/{logId} {


      allow read:
        if isAdmin();


      allow create:
        if isApprovedAccount();


      allow update, delete:
        if false;

    }




    // ============================================================
    // HELPERS
    // ============================================================

    function isSignedIn() {

      return request.auth != null;

    }


    function isAdmin() {

      return isSignedIn()
      &&
      exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      )
      &&
      get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == "admin";

    }

    // Stripe/payment truth is written only by trusted Cloud Functions. These
    // lists intentionally protect legacy campaigns too, without preventing a
    // Business from editing ordinary draft content and geometry.
    function financialCampaignFields() {
      return [
        'fundingStatus', 'fundingPaymentId', 'fundingVersion', 'fundedAt',
        'workerAmountCents', 'platformFeeRateBasisPoints',
        'platformFeeCents', 'businessChargeCents',
        'stripeCheckoutSessionId', 'stripePaymentIntentId', 'stripeChargeId',
        'paymentStatus', 'refundStatus', 'refundedAt', 'cancelledAt',
        'transferredWorkerAmountCents', 'refundedWorkerAmountCents',
        'refundedPlatformFeeCents', 'refundedTotalCents',
        'disputedAmountCents', 'settlementFrozen',
        'platformFeePendingCents', 'platformFeeRecognizedCents',
        'platformFeeRefundedCents', 'transferOperationId',
        'stripeTransferId', 'paidAmountCents', 'payoutStatus',
        'earningsStatus', 'settlementStatus'
      ];
    }

    function financialCompletionFields() {
      return [
        'verificationPassed', 'verificationStatus', 'reviewStatus',
        'reviewFinalizedAt', 'paymentStatus', 'payoutStatus',
        'payoutEligible', 'paid', 'paidAt', 'paidAmountCents',
        'transferOperationId', 'stripeTransferId', 'earningsStatus',
        'settlementStatus', 'redoRequired', 'redoCount', 'disputeOpen'
      ];
    }


    function isApprovedAccount() {

      return isSignedIn()
      &&
      exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      )
      &&
      (
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        ||
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.active == true
        ||
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.betaAccess == "approved"
      );

    }


  }

}
